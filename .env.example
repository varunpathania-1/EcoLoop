MONGODB_URI=mongodb://127.0.0.1:27017/ecoloop
JWT_SECRET=change_this_secret
PORT=3000

# ---- Resident OTP registration ----
# Development OTP mode: when true, generated OTPs are logged to the server
# terminal for testing. NEVER enable in production. Default: false.
OTP_DEV_MODE=true

# Email OTP via Gmail (required for resident registration): create a Google
# App Password (Google Account → Security → 2-Step Verification ON →
# App passwords → Mail), then fill these in. EMAIL_PASSWORD is the
# 16-character app password. Phone numbers are profile data only;
# no SMS provider is used or required.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=
EMAIL_FROM=EcoLoop <you@gmail.com>
